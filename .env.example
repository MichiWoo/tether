# =============================================================================
# Plantilla de variables de entorno del despliegue. Copiar a `.env` y rellenar.
#   cp .env.example .env
# Generar secretos con: openssl rand -hex 48
# =============================================================================

# App
NODE_ENV=production
PORT=3100
CORS_ORIGINS=

# Database (PostgreSQL) — apunta al servicio de la red interna
DATABASE_URL=postgresql://tether:tether@postgres:5432/tether?schema=public

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Shares / Transfers
SHARE_TTL_DAYS=7

# MinIO / S3 — servicio interno (puerto 9000 dentro de la red)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
# Endpoint público (TLS) para generar URLs presignadas accesibles desde el cliente.
# Si se omite, las URLs usan MINIO_ENDPOINT/port internos.
MINIO_PUBLIC_ENDPOINT=https://api.storage.woowebs.cloud
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tether
# Bucket para los artefactos de releases (bins de Tauri). Se crea automáticamente.
MINIO_RELEASES_BUCKET=releases

# Releases — protege el endpoint de registro (POST /releases) usado por CI
RELEASES_API_KEY=change-me-strong-api-key

# Auth (secrets generados — distintos por ambiente)
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# Seeder (usuario admin de arranque)
SEED_ADMIN_EMAIL=michiwoo.web@gmail.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me

# Logging
LOG_LEVEL=info

# Landing (servicio web) — base del API para los botones de descarga.
# Vacío = mismo-origen (/releases proxea al backend en nginx).
# En prod, si el proxy interno no alcanza al backend, apuntar directo al API:
# PUBLIC_API_BASE_URL=https://api.tether.woowebs.cloud
PUBLIC_API_BASE_URL=
