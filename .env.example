# =============================================================================
# Plantilla de variables de entorno del despliegue. Copiar a `.env` y rellenar.
#   cp .env.example .env
# Generar secretos con: openssl rand -hex 48
# =============================================================================

# App
NODE_ENV=production
PORT=3100
CORS_ORIGINS=

# Database (PostgreSQL) — apunta al servicio de la red interna
DATABASE_URL=postgresql://tether:tether@postgres:5432/tether?schema=public

# Redis (BullMQ)
REDIS_HOST=redis
REDIS_PORT=6379

# Shares / Transfers
SHARE_TTL_DAYS=7

# MinIO / S3 — servicio interno (puerto 9000 dentro de la red)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tether

# Auth (secrets generados — distintos por ambiente)
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d

# Seeder (usuario admin de arranque)
SEED_ADMIN_EMAIL=michiwoo.web@gmail.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me

# Logging
LOG_LEVEL=info
