generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  devices       Device[]
  refreshTokens RefreshToken[]
  clipboardItems ClipboardItem[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WINDOWS
  LINUX
  MACOS
  WEB
}

model Device {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  platform       DevicePlatform
  pushToken      String?
  lastSeenAt     DateTime?
  clipboardItems ClipboardItem[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@map("devices")
}

model ClipboardItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  sourceDeviceId String?
  sourceDevice   Device?  @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@map("clipboard_items")
}
