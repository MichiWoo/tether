generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String?
  avatarUrl     String?
  devices       Device[]
  refreshTokens RefreshToken[]
  clipboardItems ClipboardItem[]
  files         FileRecord[]
  shares        Share[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

enum DevicePlatform {
  IOS
  ANDROID
  WINDOWS
  LINUX
  MACOS
  WEB
}

model Device {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  platform       DevicePlatform
  pushToken      String?
  lastSeenAt     DateTime?
  clipboardItems ClipboardItem[]
  sentShares     Share[] @relation("ShareSender")
  targetShares   Share[] @relation("ShareTarget")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@map("devices")
}

model ClipboardItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String
  contentHash    String
  sourceDeviceId String?
  sourceDevice   Device?  @relation(fields: [sourceDeviceId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@unique([userId, sourceDeviceId, contentHash])
  @@index([userId, createdAt])
  @@map("clipboard_items")
}

enum FileStatus {
  PENDING
  UPLOADED
}

model FileRecord {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  size       Int
  mimeType   String?
  checksum   String?
  status     FileStatus @default(PENDING)
  uploadedAt DateTime?
  shares     Share[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId, createdAt])
  @@map("files")
}

enum ShareStatus {
  CREATED
  ACCEPTED
  DOWNLOADED
  EXPIRED
}

model Release {
  id          String   @id @default(cuid())
  version     String
  channel     String   @default("stable")
  platform    String
  arch        String
  filename    String
  s3Key       String
  size        Int
  checksum    String
  signature   String?
  notes       String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([version, platform, arch])
  @@index([channel, publishedAt])
  @@map("releases")
}

model Share {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  senderDeviceId String?
  senderDevice   Device?     @relation("ShareSender", fields: [senderDeviceId], references: [id], onDelete: SetNull)
  fileId         String
  file           FileRecord  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  targetDeviceId String?
  targetDevice   Device?     @relation("ShareTarget", fields: [targetDeviceId], references: [id], onDelete: SetNull)
  status         ShareStatus @default(CREATED)
  acceptedAt     DateTime?
  downloadedAt   DateTime?
  expiresAt      DateTime
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([userId, createdAt])
  @@index([targetDeviceId])
  @@index([senderDeviceId])
  @@map("shares")
}
