# App
NODE_ENV=development
PORT=3100
# Orígenes CORS permitidos (separados por coma; '*' = todos, solo para dev)
CORS_ORIGINS=

# Planes / administración
# Key del panel admin (tether_web/admin) y del header X-Plan-Admin-Key que protege
# GET/PUT /admin/* y PUT /me/plan. Vacío o sin definir = administración deshabilitada (403).
# Genera una distinta por ambiente (dev/qa/prod); nunca reutilices la de producción.
PLAN_ADMIN_KEY=change-me-strong-admin-key

# Database (PostgreSQL)
DATABASE_URL=postgresql://tether:tether@localhost:5434/tether?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Shares / Transfers
# Techo global de expiración de shares. Los TTL por plan (FREE 7 / PRO 30 / UNLIMITS 90 días)
# viven en la tabla `plans` (se aplican vía seed o desde el panel admin); este valor es la
# retención dura del servidor y nunca debe superar el TTL del plan UNLIMITS (90 días).
SHARE_TTL_DAYS=7

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tether

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change-me
REFRESH_TOKEN_EXPIRES_IN=30d

# Logging
LOG_LEVEL=info
