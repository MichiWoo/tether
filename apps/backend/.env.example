# App
NODE_ENV=development
PORT=3100

# Database (PostgreSQL)
DATABASE_URL=postgresql://tether:tether@localhost:5434/tether?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
