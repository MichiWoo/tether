{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tether",
  "version": "0.2.1",
  "identifier": "app.tether.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm typecheck && pnpm exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tether",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "createUpdaterArtifacts": true,
    "shortDescription": "Portapapeles y transferencia de archivos entre dispositivos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://api.tether.woowebs.cloud/releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDRTlFMjE4RTdGMEE5OEYKUldTUHFmRG5HT0xwZkg3TFExbmcrcVdHck5GMlVBa3c2QlV6OGdHL2V6bzlPN3Q0QkxVeUg4NW4K"
    }
  }
}
